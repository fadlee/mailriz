{
  "name": "mailriz",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/app/web"
  ],
  "scripts": {
    "build": "bun run --cwd packages/app build",
    "typecheck": "bun run --cwd packages/app typecheck && bun run --cwd packages/cli typecheck && bun run --cwd packages/app/web typecheck",
    "test": "bun run --cwd packages/app test",
    "dev:app": "bun run --cwd packages/app dev",
    "dev:web": "bun run --cwd packages/app/web dev"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
