{
  "name": "mailriz-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "bun run --cwd web build",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && bun run --cwd web typecheck",
    "test": "bun test",
    "db:migrate:local": "wrangler d1 migrations apply mailriz --local",
    "db:migrate:remote": "wrangler d1 migrations apply mailriz --remote"
  },
  "dependencies": {
    "@mailriz/shared": "workspace:*",
    "hono": "^4",
    "postal-mime": "^2",
    "ulid": "^2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "wrangler": "^4"
  }
}
