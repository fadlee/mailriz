{
  "name": "mailriz",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    // The dashboard routes client-side (/inbox, /alias/:id, …). Without this,
    // reloading on any of those paths matches no file and 404s.
    "not_found_handling": "single-page-application",
    // …but the SPA fallback swallows *navigation* requests to /api/* — an
    // iframe pointed at /api/emails/:id/html got index.html back instead of
    // the message. Fetches were unaffected, which is why it hid. Run the
    // Worker first for the API so the fallback can never reach it.
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  // Session credentials are secrets, not vars — declaring them here, even as
  // "", would overwrite the secrets on every deploy. Local dev supplies them
  // through .dev.vars instead.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "ADMIN_EMAIL": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "TRASH_RETENTION_DAYS": "30",
    "AUTH_MODE": "access",
    "DASHBOARD_HOSTNAME": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mailriz",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW_BUCKET",
      "bucket_name": "mailriz-raw",
      "preview_bucket_name": "mailriz-raw-preview"
    },
    {
      "binding": "ATTACHMENTS_BUCKET",
      "bucket_name": "mailriz-attachments",
      "preview_bucket_name": "mailriz-attachments-preview"
    },
    {
      "binding": "HTML_BUCKET",
      "bucket_name": "mailriz-html",
      "preview_bucket_name": "mailriz-html-preview"
    }
  ]
}
