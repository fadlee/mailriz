{
  "name": "mailriz",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    // The dashboard routes client-side (/inbox, /alias/:id, …). Without this,
    // reloading on any of those paths matches no file and 404s.
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "vars": {
    "ADMIN_EMAIL": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "TRASH_RETENTION_DAYS": "30",
    "AUTH_MODE": "access",
    "SESSION_PASSWORD_HASH": "",
    "DASHBOARD_HOSTNAME": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mailriz",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW_BUCKET",
      "bucket_name": "mailriz-raw",
      "preview_bucket_name": "mailriz-raw-preview"
    },
    {
      "binding": "ATTACHMENTS_BUCKET",
      "bucket_name": "mailriz-attachments",
      "preview_bucket_name": "mailriz-attachments-preview"
    },
    {
      "binding": "HTML_BUCKET",
      "bucket_name": "mailriz-html",
      "preview_bucket_name": "mailriz-html-preview"
    }
  ]
}
