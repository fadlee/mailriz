{
  "name": "mailriz-cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "mailriz-cli": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts --outdir dist --target node --format esm --external wrangler",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev": "bun run src/cli.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "wrangler": "^4"
  },
  "devDependencies": {
    "@clack/prompts": "^0.8",
    "@mailriz/shared": "workspace:*",
    "@types/bun": "latest",
    "picocolors": "^1",
    "typescript": "^5"
  }
}
